body {
  font-family: "Stardew Valley";
  font-size: 18px;
  color: white;
  background: black;
  text-align: center;
  padding: 2em 1em;
  width: 100vw;
  height: 100vh;
}

h1 {
  color: white;
  font-size: 1.5em;
  font-weight: bold;
  margin-bottom: 0.7em;
}

p {
  margin: 0.7em 0;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  align-items: center;
}
